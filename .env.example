# Copy this file to .env and paste your own key. Never commit .env.
# OpenAI is the current provider. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-key-here
# xAI is used only when config.yaml sets provider: xai. Create a key at https://console.x.ai
# XAI_API_KEY=your-key-here
